#!/usr/bin/env php
<?php

declare(strict_types=1);

use Beacon\PHP\Version;

require dirname(__DIR__) . '/vendor/autoload.php';

$command = $argv[1] ?? '--help';

if ($command === '--version' || $command === 'version') {
    printf("Beacon PHP %s\n", Version::VERSION);
    exit(0);
}

if ($command !== 'doctor') {
    fwrite(STDOUT, "Usage: beacon-php [--version|doctor]\n");
    exit($command === '--help' || $command === 'help' ? 0 : 2);
}

$extensionVersion = phpversion('opentelemetry');
$distributionConstant = 'OpenTelemetry\\Instrumentation\\BEACON_DISTRIBUTION';
$extensionDistribution = defined($distributionConstant)
    ? constant($distributionConstant)
    : null;
$checks = [
    'PHP >= 8.2' => version_compare(PHP_VERSION, '8.2.0', '>='),
    'ext-opentelemetry loaded' => extension_loaded('opentelemetry'),
    'ext-opentelemetry >= 1.4.2' => is_string($extensionVersion)
        && version_compare($extensionVersion, '1.4.2', '>='),
    'Beacon extension distribution' => $extensionDistribution === 'Beacon',
    'OpenTelemetry API installed' => interface_exists(OpenTelemetry\API\Trace\TracerProviderInterface::class),
    'OpenTelemetry SDK installed' => class_exists(OpenTelemetry\SDK\Trace\TracerProvider::class),
    'OTLP exporter installed' => class_exists(OpenTelemetry\Contrib\Otlp\SpanExporter::class),
];

$failed = false;
foreach ($checks as $label => $passed) {
    printf("[%s] %s\n", $passed ? 'OK' : 'FAIL', $label);
    $failed = $failed || !$passed;
}

$endpoint = getenv('OTEL_EXPORTER_OTLP_ENDPOINT');
printf(
    "[INFO] OTEL_EXPORTER_OTLP_ENDPOINT=%s\n",
    $endpoint === false || $endpoint === '' ? '<not set>' : $endpoint,
);

exit($failed ? 1 : 0);
