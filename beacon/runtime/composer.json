{
  "name": "beacon-observability/beacon-php",
  "version": "1.3.0",
  "type": "project",
  "license": "Apache-2.0",
  "require": {
    "php": "^8.2",
    "ext-opentelemetry": ">=1.4.2",
    "nyholm/psr7": "^1.8",
    "open-telemetry/api": "^1.10",
    "open-telemetry/exporter-otlp": "^1.4",
    "open-telemetry/sdk": "^1.15",
    "symfony/http-client": "^6.4 || ^7.0",
    "open-telemetry/opentelemetry-auto-pdo": "^0.6",
    "open-telemetry/opentelemetry-auto-curl": "^0.4",
    "open-telemetry/opentelemetry-auto-laravel": "^1.10",
    "open-telemetry/opentelemetry-auto-symfony": "^1.7",
    "open-telemetry/opentelemetry-auto-guzzle": "^1.5"
  },
  "autoload": {
    "psr-4": {
      "Beacon\\PHP\\": "app/src/"
    }
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "allow-plugins": {
      "php-http/discovery": false,
      "tbachert/spi": true
    },
    "sort-packages": true
  }
}
